<?xml version="1.0" encoding="UTF-8"?>
<fmiModelDescription
  fmiVersion="3.0"
  modelName="NBouncingBalls"
  description="This model calculates the trajectory, over time, of N balls dropped from a height."
  generationTool="Reference FMUs (development build)"
  instantiationToken="{1AE5E10D-9521-4DE3-80B9-D0EAAA7D5AF1}">

  <ModelExchange
    modelIdentifier="NBouncingBalls"
    canGetAndSetFMUState="true"
    canSerializeFMUState="true"
    providesDirectionalDerivatives="true"/>

  <CoSimulation
    modelIdentifier="NBouncingBalls"
    canGetAndSetFMUState="true"
    canSerializeFMUState="true"
    canHandleVariableCommunicationStepSize="true"
    providesIntermediateUpdate="true"
    mightReturnEarlyFromDoStep="true"
    canReturnEarlyAfterIntermediateUpdate="true"
    fixedInternalStepSize="1e-3"
    hasEventMode="true"
    providesDirectionalDerivatives="true"/>

  <UnitDefinitions>
    <Unit name="m">
      <BaseUnit m="1"/>
      <DisplayUnit name="ft" factor="3.280839895"/>
    </Unit>
    <Unit name="m/s">
      <BaseUnit m="1" s="-1"/>
    </Unit>
    <Unit name="m/s2">
      <BaseUnit m="1" s="-2"/>
    </Unit>
    <Unit name="s">
      <BaseUnit s="1"/>
    </Unit>
  </UnitDefinitions>

  <TypeDefinitions>
    <Float64Type name="Position" quantity="Position" unit="m"/>
    <Float64Type name="Velocity" quantity="Velocity" unit="m/s"/>
    <Float64Type name="Acceleration" quantity="Acceleration" unit="m/s2"/>
    <Float64Type name="TimeSpan" quantity="TimeSpan" unit="s"/>
  </TypeDefinitions>

  <LogCategories>
    <Category name="logEvents" description="Log events"/>
    <Category name="logStatusError" description="Log error messages"/>
  </LogCategories>

  <DefaultExperiment startTime="0" stopTime="3" stepSize="1e-2"/>

  <ModelVariables>
    <Float64 name="time" valueReference="0" causality="independent" variability="continuous" description="Simulation time"/>
    <Float64 name="g" valueReference="1" causality="parameter" variability="fixed" initial="exact" declaredType="Acceleration" start="-9.81" description="Gravity acting on the ball"/>
    <Float64 name="v_min" valueReference="2" variability="constant" declaredType="Velocity" start="0.1" description="Velocity below which the ball stops bouncing"/>
    <Float64 name="ground_flexibility" valueReference="3" causality="parameter" variability="tunable" declaredType="Position" start="0.1" description="Flexibility of the ground membrane"/>
    <Float64 name="base_event_period" valueReference="4" causality="parameter" variability="tunable" declaredType="TimeSpan" start="1.0" description="Base period for time events"/>
    <Float64 name="nextEventTime" valueReference="5" causality="local" variability="continuous" description="Absolute time of the next forseen discrete time event"/>

    @XML_MODEL_VARIABLES@

  </ModelVariables>

  <ModelStructure>
    @XML_MODEL_STRUCTURE@

  </ModelStructure>

</fmiModelDescription>